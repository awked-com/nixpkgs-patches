+static bool display_command(const char *verb) {
+    gchar *argv[] = { (gchar *) display_program, (gchar *) verb, "uxplay", NULL };
+    GError *error = NULL;
+    gint status;
+    bool ok;
+
+    if (!display_program)
+        return true;
+    ok = g_spawn_sync(NULL, argv, NULL, 0, NULL, NULL, NULL, NULL,
+                      &status, &error);
+    if (ok)
+        ok = g_spawn_check_wait_status(status, &error);
+    if (!ok) {
+        logger_log(logger, LOGGER_ERR, "display %s failed: %s", verb, error->message);
+        g_clear_error(&error);
+    }
