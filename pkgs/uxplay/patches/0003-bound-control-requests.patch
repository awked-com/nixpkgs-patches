+static int
+append_string(llhttp_t *parser, char **dest, const char *at, size_t length,
+              size_t limit)
+{
+    size_t used = *dest ? strlen(*dest) : 0;
+    char *next;
+
+    if (length > limit - used) {
+        return parse_error(parser, "Request field exceeds size limit");
+    }
+    next = realloc(*dest, used + length + 1);
+    if (!next) {
+        return parse_error(parser, "Request allocation failed");
+    }
+    memcpy(next + used, at, length);
+    next[used + length] = '\0';
+    *dest = next;
+    return 0;
+}
