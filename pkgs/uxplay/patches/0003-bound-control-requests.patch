+/* A single readiness notification must never wait for the rest of a request. */
+static void
+httpd_receive(httpd_t *httpd, http_connection_t *connection)
+{
+    char buffer[4096];
+    int length = recv(connection->socket_fd, buffer, sizeof(buffer), 0);
+    size_t offset = 0;
+
+    if (length <= 0) {
+        int error = length < 0 ? SOCKET_GET_ERROR() : 0;
+        if (length < 0 && httpd_would_block(error)) {
+            return;
+        }
+        httpd_remove_connection(httpd, connection, error);
+        return;
+    }
+    if (!connection->request) {
+        connection->request = http_request_init();
+        if (!connection->request) {
+            httpd_remove_connection(httpd, connection, 0);
+            return;
+        }
+        connection->deadline_ms = httpd_now_ms() + REQUEST_TIMEOUT_MS;
+        if (connection->type == CONNECTION_TYPE_PTTH) {
+            http_request_set_reverse(connection->request);
+            connection->deadline_ms = 0;
+        }
+    }
+    if (http_request_is_reverse(connection->request)) {
+        /* Reverse responses carry no retained payload in this server. */
+        return;
+    }
+    if (connection->prefix_length < sizeof(connection->prefix)) {
+        size_t needed = sizeof(connection->prefix) - connection->prefix_length;
+        offset = (size_t) length < needed ? (size_t) length : needed;
+        memcpy(connection->prefix + connection->prefix_length, buffer, offset);
+        connection->prefix_length += offset;
+        if (connection->prefix_length < sizeof(connection->prefix)) {
+            return;
+        }
+        if (!memcmp(connection->prefix, "HTTP/1.1", 8) ||
+            !memcmp(connection->prefix, "EVENT/1.0", 8)) {
+            http_request_set_reverse(connection->request);
+            return;
+        }
+        http_request_add_data(connection->request, connection->prefix, sizeof(connection->prefix));
+    }
+    if (!http_request_has_error(connection->request) && (size_t) length > offset) {
+        http_request_add_data(connection->request, buffer + offset, length - offset);
+    }
+    if (http_request_has_error(connection->request)) {
+        /* Do not log untrusted request bodies or authentication headers. */
+        logger_log(httpd->logger, LOGGER_WARNING, "Discarding invalid or oversized request on socket %d",
+                   connection->socket_fd);
+        httpd_remove_connection(httpd, connection, 0);
+        return;
+    }
+    if (http_request_is_complete(connection->request)) {
+        httpd->callbacks.conn_request(connection->user_data, connection->request, &connection->response);
+        http_request_destroy(connection->request);
+        connection->request = NULL;
+        connection->prefix_length = 0;
+        connection->response_written = 0;
+        if (connection->response) {
+            connection->deadline_ms = httpd_now_ms() + RESPONSE_TIMEOUT_MS;
+        } else {
+            httpd_remove_connection(httpd, connection, 0);
+        }
+    }
+}
+
+static void
+httpd_send_response(httpd_t *httpd, http_connection_t *connection)
+{
+    int length;
+    int flags = 0;
+    const char *data = http_response_get_data(connection->response, &length);
+    int remaining = length - connection->response_written;
+
+#ifdef MSG_NOSIGNAL
+    flags = MSG_NOSIGNAL;
+#endif
+    if (remaining > 0) {
+        /* Cap work per readiness notification, including large responses. */
+        int chunk = remaining < 65536 ? remaining : 65536;
+        int written = send(connection->socket_fd, data + connection->response_written, chunk, flags);
+        if (written <= 0) {
+            int error = written < 0 ? SOCKET_GET_ERROR() : 0;
+            if (written < 0 && httpd_would_block(error)) {
+                return;
+            }
+            httpd_remove_connection(httpd, connection, error);
+            return;
+        }
+        connection->response_written += written;
+    }
+    if (connection->response_written == length) {
+        bool disconnect = http_response_get_disconnect(connection->response);
+        http_response_destroy(connection->response);
+        connection->response = NULL;
+        connection->response_written = 0;
+        /* Keep established media sessions alive while awaiting their next command. */
+        connection->deadline_ms = connection->type == CONNECTION_TYPE_UNKNOWN ?
+                                 httpd_now_ms() + ACCEPT_TIMEOUT_MS : 0;
+        if (disconnect) {
+            httpd_remove_connection(httpd, connection, 0);
+        }
+    }
+}
