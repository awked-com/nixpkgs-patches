+static void schedule_sink_retry(void)
+{
+	uint64_t delay, elapsed, now, remaining;
+
+	now = shl_now(CLOCK_MONOTONIC);
+	elapsed = now - sink_connect_started;
+	if (elapsed >= SINK_CONNECT_DEADLINE_USEC) {
+		delay = 0;
+		remaining = 0;
+	} else if (elapsed < SINK_CONNECT_FAST_WINDOW_USEC) {
+		delay = SINK_CONNECT_FAST_RETRY_USEC;
+		remaining = SINK_CONNECT_DEADLINE_USEC - elapsed;
+	} else {
+		delay = SINK_CONNECT_SLOW_RETRY_USEC;
+		remaining = SINK_CONNECT_DEADLINE_USEC - elapsed;
+	}
+	if (delay > remaining)
+		delay = remaining;
+
+	schedule_timeout(&sink_timeout, delay, sink_timeout_fn, NULL);
