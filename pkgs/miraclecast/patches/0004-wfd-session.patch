+static void start_transport_monitor(const char *address)
+{
+	stop_timeout(&transport_timer);
+	if (address && strcmp(address, "0.0.0.0") &&
+	    inet_pton(AF_INET, address, &transport_address) == 1)
+		schedule_timeout(&transport_timer, TRANSPORT_CHECK_INTERVAL_USEC,
+				 transport_timer_fn, NULL);
+}
+
+static int player_notify_fn(sd_event_source *source,
+			    int fd,
+			    uint32_t revents,
+			    void *data)
+{
+	char buf[64];
+	ssize_t len, i;
+	bool idr = false;
+	bool ready = false;
+	bool stopped = false;
+
+	len = read(fd, buf, sizeof(buf));
+	for (i = 0; i < len; i++) {
+		if (buf[i] == SINK_PLAYER_EVENT_IDR)
+			idr = true;
+		else if (buf[i] == SINK_PLAYER_EVENT_READY)
+			ready = true;
+		else if (buf[i] == SINK_PLAYER_EVENT_STOPPED)
+			stopped = true;
+	}
+	if (len == 0 || (revents & (EPOLLHUP | EPOLLERR)))
+		stopped = true;
+
+	if (ready && !stopped) {
+		session_video_ready = true;
+		finish_session_start();
+	}
+
+	if (idr && !stopped)
+		ctl_sink_request_idr(sink);
+
+	if (stopped) {
+		cli_notice("stream player stopped");
+		end_session();
+		release_running_peer(true);
+	}
+
+	return 0;
+}
+
+static void start_player(struct ctl_sink *s)
+{
+	struct sink_player_config config = {
+		.bind_address = running_peer ?
+				running_peer->local_address : NULL,
+		.port = rstp_port,
+		.video_decoder = player_video_decoder,
+		.video_caps = player_video_caps,
+		.video_sink = player_video_sink,
+		/* Missing audio must not hold video in preroll. */
+		.audio_sink = wfd_audio_enabled ? player_audio_sink :
+			"fakesink sync=false async=false",
+		.gst_debug = gst_debug,
+	};
+	int r;
+
+	if (sink_player_running())
+		return;
+
+	if (!run_display_power("acquire")) {
+		end_session();
+		release_running_peer(true);
+		return;
+	}
+
+	r = sink_player_start(&config);
+	if (r >= 0) {
+		r = sd_event_add_io(cli_event,
+				    &player_notify_source,
+				    sink_player_notify_fd(),
+				    EPOLLIN,
+				    player_notify_fn,
+				    NULL);
+		if (r < 0)
+			sink_player_stop();
+	}
+	if (r < 0) {
+		cli_vERR(r);
+		run_display_power("release");
+		end_session();
+		release_running_peer(true);
+		return;
+	}
+
+	start_transport_monitor(config.bind_address);
 }
 
