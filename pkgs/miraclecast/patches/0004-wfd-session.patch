+/* Native-mode geometry must agree with the advertised masks. */
+uint8_t vfd_get_native_index(uint32_t cea_mask,
+			     uint32_t vesa_mask,
+			     uint32_t hh_mask)
+{
+	const struct resolution_bitmap *tables[] = {
+		resolutions_cea,
+		resolutions_vesa,
+		resolutions_hh,
+	};
+	const uint32_t masks[] = { cea_mask, vesa_mask, hh_mask };
+	unsigned int table;
+	int best_area = 0;
+	int best_fps = 0;
+	uint8_t native = 0;
+	int i, area;
+
+	for (table = 0; table < SHL_ARRAY_LENGTH(tables); table++) {
+		const struct resolution_bitmap *res = tables[table];
+
+		for (i = 0; res[i].hres != 0; i++) {
+			if (!((1U << res[i].index) & masks[table]))
+				continue;
+
+			area = res[i].hres * res[i].vres;
+			if (area < best_area)
+				continue;
+			if (area == best_area && res[i].fps <= best_fps)
+				continue;
+
+			best_area = area;
+			best_fps = res[i].fps;
+			native = (res[i].index << 3) | table;
+		}
+	}
+
+	return native;
+}
