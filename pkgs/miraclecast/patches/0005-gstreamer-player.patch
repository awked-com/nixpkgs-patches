+#ifndef CTL_SINK_PLAYER_H
+#define CTL_SINK_PLAYER_H
+
+#include <stdbool.h>
+
+struct sink_player_config {
+	const char *bind_address;	/* NULL: 0.0.0.0 */
+	int port;			/* <= 0: 7236 */
+	const char *video_decoder;	/* NULL: avdec_h264 */
+	const char *video_caps;		/* NULL: video/x-raw */
+	const char *video_sink;		/* NULL: autovideosink */
+	const char *audio_sink;		/* NULL: autoaudiosink */
+	const char *gst_debug;		/* NULL: leave untouched */
+};
+
+/* One byte per event; reap STOPPED with sink_player_stop(). */
+#define SINK_PLAYER_EVENT_IDR 'I'
+#define SINK_PLAYER_EVENT_READY 'R'
+#define SINK_PLAYER_EVENT_STOPPED 'S'
+
+/* Construction failures arrive asynchronously as STOPPED. */
+int sink_player_start(const struct sink_player_config *config);
+
+/* Valid between sink_player_start() and sink_player_stop(). */
+int sink_player_notify_fd(void);
+
+bool sink_player_running(void);
+
+void sink_player_reset_video(void);
+
+void sink_player_set_paused(bool paused);
+
+void sink_player_stop(void);
+
+#endif /* CTL_SINK_PLAYER_H */
