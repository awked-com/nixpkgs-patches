+static int supplicant_p2p_cancel_fn(struct wpas *w,
+				    struct wpas_message *reply,
+				    void *data)
+{
+	struct supplicant *s = data;
+
+	if (wpas_message_is_fail(reply))
+		log_warning("P2P_CANCEL failed");
+
+	/* P2P_FIND before the cancel reply races the queued P2P_CANCEL. */
+	if (s->running && s->has_p2p && s->scan_requested && !s->pending)
+		supplicant_p2p_start_scan(s);
+
+	return 0;
+}
+
+static void supplicant_p2p_cancel(struct supplicant *s)
+{
+	_wpas_message_unref_ struct wpas_message *m = NULL;
+	int r;
+
+	r = wpas_message_new_request(s->bus_global, "P2P_CANCEL", &m);
+	if (r < 0) {
+		log_vERR(r);
+		return;
+	}
+
+	r = wpas_call_async(s->bus_global,
+			    m,
+			    supplicant_p2p_cancel_fn,
+			    s,
+			    0,
+			    NULL);
+	if (r < 0) {
+		log_vERR(r);
+		return;
+	}
+
+	log_debug("sent P2P_CANCEL to wpas on %s", s->l->ifname);
+}
