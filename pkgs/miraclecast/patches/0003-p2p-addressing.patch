+static int run_ip(char *argv[])
+{
+	int status;
+	pid_t pid, rp;
+
+	pid = fork();
+	if (pid < 0)
+		return log_ERRNO();
+	if (!pid) {
+		dup2(2, 1);
+		execve(argv[0], argv, environ);
+		_exit(1);
+	}
+
+	do {
+		rp = waitpid(pid, &status, 0);
+	} while (rp < 0 && errno == EINTR);
+
+	if (rp != pid || !WIFEXITED(status) || WEXITSTATUS(status))
+		return -EFAULT;
+
+	return 0;
+}
