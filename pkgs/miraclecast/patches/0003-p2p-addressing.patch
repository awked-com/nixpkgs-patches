+static int network_prefix(const char *address, char *prefix, size_t size)
+{
+	const char *slash;
+	char host[INET_ADDRSTRLEN], network[INET_ADDRSTRLEN];
+	struct in_addr ip, mask, net;
+	char *end;
+	unsigned long prefix_len;
+	uint32_t mask_bits;
+	bool zero_seen = false;
+	int host_len, bits, r, bit;
+
+	slash = strchr(address, '/');
+	if (!slash || slash == address)
+		goto error;
+
+	host_len = slash - address;
+	if (host_len >= (int)sizeof(host))
+		goto error;
+	memcpy(host, address, host_len);
+	host[host_len] = 0;
+
+	if (inet_pton(AF_INET, host, &ip) != 1)
+		goto error;
+
+	if (strchr(slash + 1, '.')) {
+		if (inet_pton(AF_INET, slash + 1, &mask) != 1)
+			goto error;
+	} else {
+		errno = 0;
+		prefix_len = strtoul(slash + 1, &end, 10);
+		if (errno || end == slash + 1 || *end || prefix_len > 32)
+			goto error;
+
+		mask_bits = prefix_len ? UINT32_MAX << (32 - prefix_len) : 0;
+		mask.s_addr = htonl(mask_bits);
+	}
+
+	mask_bits = ntohl(mask.s_addr);
+	bits = 0;
+	for (bit = 31; bit >= 0; --bit) {
+		if (mask_bits & (UINT32_C(1) << bit)) {
+			if (zero_seen)
+				goto error;
+			++bits;
+		} else {
+			zero_seen = true;
+		}
+	}
+
+	net.s_addr = ip.s_addr & mask.s_addr;
+	if (!inet_ntop(AF_INET, &net, network, sizeof(network)))
+		goto error;
+
+	r = snprintf(prefix, size, "%s/%d", network, bits);
+	if (r < 0 || (size_t)r >= size)
+		goto error;
+
+	return 0;
+
+error:
+	log_error("invalid address prefix: %s", address);
+	return -EINVAL;
+}
