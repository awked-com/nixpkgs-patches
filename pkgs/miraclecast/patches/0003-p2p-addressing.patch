+static int install_if_route(const char *address)
+{
+	char prefix[INET_ADDRSTRLEN + 4];
+	char *argv[] = {
+		(char*)arg_ip_binary,
+		(char*)"route",
+		(char*)"replace",
+		prefix,
+		(char*)"dev",
+		(char*)arg_netdev,
+		(char*)"table",
+		(char*)arg_route_table,
+		NULL,
+	};
+	int r;
+
+	if (!arg_route_table)
+		return 0;
+
+	r = network_prefix(address, prefix, sizeof(prefix));
+	if (r < 0)
