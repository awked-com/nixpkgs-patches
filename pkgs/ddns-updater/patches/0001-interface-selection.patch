--- /dev/null
+++ ddns-updater/pkg/publicip/interface.go
@@ -0,0 +1,73 @@
+package publicip
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+)
+
+type interfaceFetcher struct {
+	name string
+}
+
+func newInterfaceFetcher(name string) *interfaceFetcher {
+	return &interfaceFetcher{name: name}
+}
+
+func (f *interfaceFetcher) IP(ctx context.Context) (netip.Addr, error) {
+	return f.IP4(ctx)
+}
+
+func (f *interfaceFetcher) IP4(ctx context.Context) (netip.Addr, error) {
+	return f.address(ctx, true)
+}
+
+func (f *interfaceFetcher) IP6(ctx context.Context) (netip.Addr, error) {
+	return f.address(ctx, false)
+}
+
+func (f *interfaceFetcher) address(ctx context.Context, ipv4 bool) (netip.Addr, error) {
+	if err := ctx.Err(); err != nil {
+		return netip.Addr{}, err
+	}
+
+	iface, err := net.InterfaceByName(f.name)
+	if err != nil {
+		return netip.Addr{}, fmt.Errorf("finding interface %q: %w", f.name, err)
+	}
+
+	addresses, err := iface.Addrs()
+	if err != nil {
+		return netip.Addr{}, fmt.Errorf("listing addresses on interface %q: %w", f.name, err)
+	}
+
+	address, err := selectInterfaceAddress(addresses, ipv4)
+	if err != nil {
+		family := "IPv6"
+		if ipv4 {
+			family = "IPv4"
+		}
+		return netip.Addr{}, fmt.Errorf("finding global unicast %s address on interface %q: %w",
+			family, f.name, err)
+	}
+	return address, nil
+}
+
+var errNoInterfaceAddress = errors.New("no matching address")
+
+func selectInterfaceAddress(addresses []net.Addr, ipv4 bool) (netip.Addr, error) {
+	for _, address := range addresses {
+		prefix, err := netip.ParsePrefix(address.String())
+		if err != nil {
+			continue
+		}
+
+		ip := prefix.Addr().Unmap()
+		if ip.Is4() == ipv4 && ip.IsGlobalUnicast() {
+			return ip, nil
+		}
+	}
+	return netip.Addr{}, errNoInterfaceAddress
+}
