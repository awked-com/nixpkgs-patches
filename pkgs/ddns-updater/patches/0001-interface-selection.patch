@@ -0,0 +1,39 @@
+package publicip
+
+import (
+	"net"
+	"net/netip"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSelectInterfaceAddress(t *testing.T) {
+	t.Parallel()
+
+	addresses := []net.Addr{
+		&net.IPNet{IP: net.ParseIP("127.0.0.1"), Mask: net.CIDRMask(8, 32)},
+		&net.IPNet{IP: net.ParseIP("2001:db8::1"), Mask: net.CIDRMask(64, 128)},
+		&net.IPNet{IP: net.ParseIP("192.0.2.10"), Mask: net.CIDRMask(24, 32)},
+	}
+
+	ipv4, err := selectInterfaceAddress(addresses, true)
+	require.NoError(t, err)
+	assert.Equal(t, netip.MustParseAddr("192.0.2.10"), ipv4)
+
+	ipv6, err := selectInterfaceAddress(addresses, false)
+	require.NoError(t, err)
+	assert.Equal(t, netip.MustParseAddr("2001:db8::1"), ipv6)
+}
+
+func TestSelectInterfaceAddressMissing(t *testing.T) {
+	t.Parallel()
+
+	addresses := []net.Addr{
+		&net.IPNet{IP: net.ParseIP("127.0.0.1"), Mask: net.CIDRMask(8, 32)},
+	}
+
+	_, err := selectInterfaceAddress(addresses, true)
+	assert.ErrorIs(t, err, errNoInterfaceAddress)
+}
